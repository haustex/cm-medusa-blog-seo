{
  "name": "medusa-blog-seo",
  "version": "0.1.0",
  "description": "Multilingual blog for Medusa v2 with SEO built in: posts, categories, authors, any number of locales with fallback rules, scheduled publishing, preview links, rich editor, shoppable product cards, JSON-LD / hreflang / sitemap / RSS helpers — by Haus Kayu",
  "author": "Haus Kayu <dev@hauskayu.com> (https://hauskayu.com)",
  "license": "MIT",
  "homepage": "https://github.com/haustex/cm-medusa-blog-seo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haustex/cm-medusa-blog-seo.git"
  },
  "bugs": {
    "url": "https://github.com/haustex/cm-medusa-blog-seo/issues",
    "email": "dev@hauskayu.com"
  },
  "funding": "https://hauskayu.com",
  "files": [
    ".medusa/server",
    "!.medusa/server/**/__tests__",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./sdk": "./.medusa/server/src/sdk.js",
    "./jsonld": "./.medusa/server/src/jsonld.js",
    "./seo": "./.medusa/server/src/seo.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "blog",
    "cms",
    "content",
    "i18n",
    "multilingual",
    "translations",
    "seo",
    "json-ld",
    "hreflang",
    "sitemap",
    "rss",
    "scheduled-publishing"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "jest",
    "test:unit": "jest",
    "guard": "node scripts/guard.mjs",
    "db:generate": "node scripts/guard.mjs medusa plugin:db:generate",
    "prepublishOnly": "medusa plugin:build",
    "pack:check": "node scripts/check-pack.mjs",
    "test:e2e": "node integration-tests/e2e.mjs"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "htmlparser2": "12.0.0",
    "multer": "^2.0.0",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/eslint-plugin": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/js-sdk": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/test-utils": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "sharp": "0.35.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.19.0",
    "@medusajs/cli": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/icons": "^2.19.0",
    "@medusajs/js-sdk": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/test-utils": "^2.19.0",
    "@medusajs/ui": "^4.2.1",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@10.9.9"
}
